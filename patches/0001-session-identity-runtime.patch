diff --git a/codex-rs/app-server/src/request_processors/thread_identity.rs b/codex-rs/app-server/src/request_processors/thread_identity.rs
new file mode 100644
index 0000000..b19b035
--- /dev/null
+++ b/codex-rs/app-server/src/request_processors/thread_identity.rs
@@ -0,0 +1,525 @@
+use super::*;
+use codex_app_server_protocol::ThreadIdentityReadParams;
+use codex_app_server_protocol::ThreadIdentityResponse;
+use codex_app_server_protocol::ThreadIdentitySetParams;
+use codex_login::AuthManagerConfig;
+use serde::Deserialize;
+use serde::Serialize;
+use tokio::io::AsyncWriteExt;
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct IdentityBinding {
+    pub identity_id: String,
+    pub revision: u32,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct IdentityProfile {
+    kind: String,
+    provider_id: String,
+    model: Option<String>,
+    account_id: Option<String>,
+    user_id: Option<String>,
+    provider: Option<serde_json::Value>,
+}
+
+fn validate_identity_id(value: &str) -> Result<(), JSONRPCErrorError> {
+    if value.is_empty()
+        || value.len() > 100
+        || !value
+            .bytes()
+            .all(|c| c.is_ascii_alphanumeric() || c == b'_' || c == b'-')
+    {
+        return Err(invalid_params("invalid identity reference"));
+    }
+    Ok(())
+}
+
+impl ThreadRequestProcessor {
+    pub(super) async fn pinned_identity_provider(
+        &self,
+        identity_id: &str,
+    ) -> Result<(String, Option<serde_json::Value>), JSONRPCErrorError> {
+        validate_identity_id(identity_id)?;
+        let path = self
+            .identity_directory()
+            .join("profiles")
+            .join(identity_id)
+            .join("profile.json");
+        let bytes = tokio::fs::read(path)
+            .await
+            .map_err(|_| invalid_request("identity profile is unavailable"))?;
+        let profile: IdentityProfile = serde_json::from_slice(&bytes)
+            .map_err(|_| invalid_request("identity profile is invalid"))?;
+        Ok((profile.provider_id, profile.provider))
+    }
+    fn identity_directory(&self) -> PathBuf {
+        self.config
+            .codex_home
+            .join("session-identities")
+            .to_path_buf()
+    }
+
+    pub(super) async fn load_identity_binding(
+        &self,
+        id: ThreadId,
+    ) -> Result<Option<IdentityBinding>, JSONRPCErrorError> {
+        let path = self
+            .identity_directory()
+            .join("bindings")
+            .join(format!("{id}.json"));
+        let bytes = match tokio::fs::read(path).await {
+            Ok(bytes) => bytes,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+            Err(_) => return Err(internal_error("cannot read identity binding")),
+        };
+        let binding: IdentityBinding = serde_json::from_slice(&bytes)
+            .map_err(|_| internal_error("invalid identity binding"))?;
+        validate_identity_id(&binding.identity_id)?;
+        Ok(Some(binding))
+    }
+
+    pub(super) async fn save_identity_binding(
+        &self,
+        id: ThreadId,
+        binding: Option<&IdentityBinding>,
+    ) -> Result<(), JSONRPCErrorError> {
+        let directory = self.identity_directory().join("bindings");
+        tokio::fs::create_dir_all(&directory)
+            .await
+            .map_err(|_| internal_error("cannot create binding directory"))?;
+        let destination = directory.join(format!("{id}.json"));
+        let Some(binding) = binding else {
+            return match tokio::fs::remove_file(destination).await {
+                Ok(()) => Ok(()),
+                Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(()),
+                Err(_) => Err(internal_error("cannot restore unbound identity")),
+            };
+        };
+        let temporary = directory.join(format!("{id}.{}.tmp", uuid::Uuid::new_v4()));
+        let bytes = serde_json::to_vec(binding)
+            .map_err(|_| internal_error("cannot encode identity binding"))?;
+        let result = async {
+            let mut file = tokio::fs::OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .open(&temporary)
+                .await?;
+            file.write_all(&bytes).await?;
+            file.sync_all().await?;
+            drop(file);
+            tokio::fs::rename(&temporary, destination).await
+        }
+        .await;
+        if result.is_err() {
+            let _ = tokio::fs::remove_file(temporary).await;
+            return Err(internal_error("cannot persist identity binding"));
+        }
+        Ok(())
+    }
+
+    pub(super) async fn prepare_identity_runtime(
+        &self,
+        current: &Config,
+        identity_id: &str,
+    ) -> Result<(Config, Arc<AuthManager>), JSONRPCErrorError> {
+        validate_identity_id(identity_id)?;
+        if codex_login::is_workload_identity_selected()
+            || std::env::var_os(codex_login::CODEX_ACCESS_TOKEN_ENV_VAR).is_some()
+        {
+            return Err(invalid_request(
+                "process-wide external authentication cannot be used with an identity profile",
+            ));
+        }
+        let directory = self.identity_directory().join("profiles").join(identity_id);
+        let bytes = tokio::fs::read(directory.join("profile.json"))
+            .await
+            .map_err(|_| invalid_request("identity profile is unavailable"))?;
+        let profile: IdentityProfile = serde_json::from_slice(&bytes)
+            .map_err(|_| invalid_request("identity profile is invalid"))?;
+        if profile.kind != "chatgpt" && profile.kind != "chatgpt-system" && profile.kind != "api" {
+            return Err(invalid_request("unsupported identity kind"));
+        }
+        let mut retained_flags = toml::Value::Table(Default::default());
+        for layer in current.config_layer_stack.layers_low_to_high() {
+            if matches!(layer.name, codex_config::ConfigLayerSource::SessionFlags) {
+                codex_config::merge_toml_values(&mut retained_flags, &layer.config);
+            }
+        }
+        let mut overrides: HashMap<String, serde_json::Value> = serde_json::from_value(
+            serde_json::to_value(retained_flags)
+                .map_err(|_| internal_error("cannot retain session settings"))?,
+        )
+        .map_err(|_| internal_error("invalid retained session settings"))?;
+        if let Some(provider) = profile.provider.clone() {
+            let providers = overrides
+                .entry("model_providers".to_string())
+                .or_insert_with(|| serde_json::json!({}));
+            providers
+                .as_object_mut()
+                .ok_or_else(|| internal_error("invalid retained providers"))?
+                .insert(profile.provider_id.clone(), provider);
+        }
+        let mut config = self
+            .config_manager
+            .load_for_cwd(
+                Some(overrides),
+                ConfigOverrides {
+                    model_provider: Some(profile.provider_id.clone()),
+                    model: profile.model.or_else(|| current.model.clone()),
+                    cwd: Some(current.cwd.to_path_buf()),
+                    base_instructions: current.base_instructions.clone(),
+                    developer_instructions: current.developer_instructions.clone(),
+                    compact_prompt: current.compact_prompt.clone(),
+                    review_model: current.review_model.clone(),
+                    show_raw_agent_reasoning: Some(current.show_raw_agent_reasoning),
+                    ..Default::default()
+                },
+                Some(current.cwd.to_path_buf()),
+            )
+            .await
+            .map_err(|error| config_load_error(&error))?;
+        if config.model_provider_id != profile.provider_id {
+            return Err(invalid_request(
+                "managed requirements rejected the identity provider",
+            ));
+        }
+        self.config_manager
+            .check_thread_model_provider(&config)
+            .await
+            .map_err(|error| config_load_error(&error))?;
+        let auth_config = codex_login::AuthConfig {
+            codex_home: directory,
+            auth_credentials_store_mode: codex_login::AuthCredentialsStoreMode::File,
+            keyring_backend_kind: config.auth_keyring_backend_kind(),
+            forced_login_method: config.forced_login_method(),
+            forced_chatgpt_workspace_id: config.forced_chatgpt_workspace_id(),
+            managed_auth_policy: config.managed_auth_policy(),
+            chatgpt_base_url: Some(config.chatgpt_base_url.clone()),
+            auth_route_config: config.auth_route_config(),
+        };
+        let mut cache = self.identity_auth_cache.lock().await;
+        let manager = if profile.kind == "chatgpt-system" {
+            Arc::clone(&self.auth_manager)
+        } else {
+            match cache.get(identity_id) {
+                Some((cached_config, manager)) if cached_config == &auth_config => {
+                    Arc::clone(manager)
+                }
+                _ => {
+                    let manager = AuthManager::shared_from_auth_config(auth_config.clone(), false)
+                        .await
+                        .map_err(|_| invalid_request("identity authentication is unavailable"))?;
+                    cache.insert(
+                        identity_id.to_owned(),
+                        (auth_config.clone(), Arc::clone(&manager)),
+                    );
+                    manager
+                }
+            }
+        };
+        drop(cache);
+        let auth = manager.auth().await;
+        if profile.kind == "chatgpt" || profile.kind == "chatgpt-system" {
+            let valid = auth.as_ref().is_some_and(|auth| {
+                auth.is_chatgpt_auth()
+                    && auth_config.allows_auth(auth)
+                    && profile.account_id.is_some()
+                    && auth.get_account_id() == profile.account_id
+                    && profile.user_id.is_some()
+                    && auth.get_chatgpt_user_id() == profile.user_id
+            });
+            if !valid || !config.model_provider.requires_openai_auth {
+                return Err(invalid_request(
+                    "official account does not match its registered identity",
+                ));
+            }
+            config.expected_model_identity = profile.account_id.zip(profile.user_id);
+        } else if auth.as_ref().is_some_and(|auth| !auth.is_api_key_auth()) {
+            return Err(invalid_request("API identity contains non-API credentials"));
+        } else if config.model_provider.requires_openai_auth && auth.is_none() {
+            return Err(invalid_request("API identity credentials are unavailable"));
+        }
+        Ok((config, manager))
+    }
+
+    pub(crate) async fn thread_identity_read(
+        &self,
+        params: ThreadIdentityReadParams,
+    ) -> Result<ThreadIdentityResponse, JSONRPCErrorError> {
+        let id = ThreadId::from_string(&params.thread_id)
+            .map_err(|_| invalid_params("invalid thread ID"))?;
+        let binding = self.load_identity_binding(id).await?;
+        let loaded = self.thread_manager.get_thread(id).await.is_ok();
+        let cached = self.identity_bindings.lock().await.get(&id).cloned();
+        let verified = loaded && binding.is_some() && cached == binding;
+        Ok(ThreadIdentityResponse {
+            thread_id: id.to_string(),
+            identity_id: binding.as_ref().map(|b| b.identity_id.clone()),
+            revision: binding.map_or(0, |b| b.revision),
+            verified,
+            status: if verified {
+                "applied"
+            } else if loaded {
+                "unbound"
+            } else {
+                "unloaded"
+            }
+            .to_string(),
+        })
+    }
+
+    pub(crate) async fn thread_identity_set(
+        &self,
+        request_id: ConnectionRequestId,
+        params: ThreadIdentitySetParams,
+        client_name: Option<String>,
+        client_version: Option<String>,
+    ) -> Result<ThreadIdentityResponse, JSONRPCErrorError> {
+        validate_identity_id(&params.identity_id)?;
+        let _permit = self.acquire_thread_list_state_permit().await?;
+        let requested_id = ThreadId::from_string(&params.thread_id)
+            .map_err(|_| invalid_params("invalid thread ID"))?;
+        if self.thread_manager.get_thread(requested_id).await.is_err() {
+            let previous = self.load_identity_binding(requested_id).await?;
+            if previous.as_ref().map_or(0, |b| b.revision) != params.expected_revision {
+                return Err(invalid_request(
+                    "identity revision changed; refresh before switching",
+                ));
+            }
+            let stored = self
+                .read_stored_thread_for_resume(&params.thread_id, None, false)
+                .await?;
+            if stored.parent_thread_id.is_some()
+                || stored.source.is_non_root_agent()
+                || stored.archived_at.is_some()
+            {
+                return Err(invalid_request(
+                    "identity selection requires an unarchived root thread",
+                ));
+            }
+            let mut current = self.config.as_ref().clone();
+            current.cwd = AbsolutePathBuf::from_absolute_path(&stored.cwd)
+                .map_err(|_| invalid_request("invalid stored working directory"))?;
+            current.model = stored.model;
+            drop(_permit);
+            self.prepare_identity_runtime(&current, &params.identity_id)
+                .await?;
+            let _permit = self.acquire_thread_list_state_permit().await?;
+            if self.thread_manager.get_thread(requested_id).await.is_ok()
+                || self.load_identity_binding(requested_id).await? != previous
+            {
+                return Err(invalid_request(
+                    "thread changed during identity preparation; retry",
+                ));
+            }
+            let binding = IdentityBinding {
+                identity_id: params.identity_id,
+                revision: params
+                    .expected_revision
+                    .checked_add(1)
+                    .ok_or_else(|| invalid_request("identity revision exhausted"))?,
+            };
+            self.save_identity_binding(requested_id, Some(&binding))
+                .await?;
+            return self
+                .thread_identity_read(ThreadIdentityReadParams {
+                    thread_id: params.thread_id,
+                })
+                .await;
+        }
+        let (id, thread) = self.load_thread(&params.thread_id).await?;
+        ensure_direct_input_allowed(thread.as_ref()).await?;
+        let previous = self.load_identity_binding(id).await?;
+        if previous.as_ref().map_or(0, |b| b.revision) != params.expected_revision {
+            return Err(invalid_request(
+                "identity revision changed; refresh before switching",
+            ));
+        }
+        let snapshot = thread.config_snapshot().await;
+        if snapshot.ephemeral || snapshot.session_source.is_non_root_agent() {
+            return Err(invalid_request(
+                "identity switching currently requires a persisted root thread",
+            ));
+        }
+        if matches!(thread.agent_status().await, AgentStatus::Running)
+            || !thread.list_background_terminals().await.is_empty()
+            || matches!(
+                self.thread_watch_manager
+                    .loaded_status_for_thread(&id.to_string())
+                    .await,
+                ThreadStatus::Active { .. }
+            )
+        {
+            let mut state = self
+                .thread_identity_read(ThreadIdentityReadParams {
+                    thread_id: params.thread_id,
+                })
+                .await?;
+            state.status = "busy".to_string();
+            return Ok(state);
+        }
+        for child in self
+            .thread_manager
+            .list_agent_subtree_thread_ids(id)
+            .await
+            .map_err(|_| internal_error("cannot inspect child runtimes"))?
+        {
+            if child != id && self.thread_manager.get_thread(child).await.is_ok() {
+                let mut state = self
+                    .thread_identity_read(ThreadIdentityReadParams {
+                        thread_id: id.to_string(),
+                    })
+                    .await?;
+                state.status = "busy".to_string();
+                return Ok(state);
+            }
+        }
+        let old = ThreadRevertRuntimeSnapshot {
+            config: thread.config().await.as_ref().clone(),
+            settings: thread.restorable_thread_settings().await,
+            client_mcp_extensions: thread.client_mcp_extensions(),
+            auth_manager: thread.identity_auth_manager(),
+        };
+        let mut current_config = old.config.clone();
+        current_config.model = Some(snapshot.model.clone());
+        drop(_permit);
+        let (config, manager) = self
+            .prepare_identity_runtime(&current_config, &params.identity_id)
+            .await?;
+        let _permit = self.acquire_thread_list_state_permit().await?;
+        if !self
+            .thread_manager
+            .get_thread(id)
+            .await
+            .is_ok_and(|current| Arc::ptr_eq(&current, &thread))
+            || self.load_identity_binding(id).await? != previous
+        {
+            return Err(invalid_request(
+                "thread changed during identity preparation; retry",
+            ));
+        }
+        let mut next = old.clone();
+        next.config = config;
+        next.settings.model = next.config.model.clone();
+        if let Some(mode) = next.settings.collaboration_mode.as_mut() {
+            if let Some(model) = next.config.model.as_ref() {
+                mode.settings.model = model.clone();
+            }
+        }
+        next.auth_manager = manager;
+        let binding = IdentityBinding {
+            identity_id: params.identity_id,
+            revision: params
+                .expected_revision
+                .checked_add(1)
+                .ok_or_else(|| invalid_request("identity revision exhausted"))?,
+        };
+        self.thread_store
+            .persist_thread(id, PersistContext::Standard)
+            .await
+            .map_err(|_| internal_error("cannot persist thread before identity replacement"))?;
+        thread
+            .checkpoint_thread_settings()
+            .await
+            .map_err(|_| internal_error("cannot checkpoint thread before identity replacement"))?;
+        let was_subscribed = self
+            .thread_state_manager
+            .subscribed_connection_ids(id)
+            .await
+            .contains(&request_id.connection_id);
+        let result=async {
+        self.ensure_conversation_listener(id, request_id.connection_id, false)
+            .await?;
+        let thread_state = self.thread_state_manager.thread_state(id).await;
+        let drain = thread_state.lock().await.register_shutdown_drain_waiter();
+        if !thread
+            .shutdown_if_idle()
+            .await
+            .map_err(|_| internal_error("cannot drain idle thread"))?
+        {
+            thread_state.lock().await.take_shutdown_drain_waiter();
+            let mut state = self
+                .thread_identity_read(ThreadIdentityReadParams {
+                    thread_id: id.to_string(),
+                })
+                .await?;
+            state.status = "busy".to_string();
+            return Ok(state);
+        }
+        if !matches!(tokio::time::timeout(Duration::from_secs(10), drain).await,Ok(Ok(()))) {
+            thread_state.lock().await.take_shutdown_drain_waiter();
+            self.thread_manager.remove_thread(&id).await;
+            self.finalize_thread_teardown(id).await;
+            return Err(internal_error("identity replacement could not drain its listener; the saved thread can be reopened"));
+        }
+        self.thread_manager.remove_thread(&id).await;
+        self.outgoing.cancel_requests_for_thread(id, None).await;
+        let switched = async {
+            self.save_identity_binding(id, Some(&binding)).await?;
+            self.reload_paginated_thread(
+                &request_id,
+                id,
+                next,
+                client_name.clone(),
+                client_version.clone(),
+            )
+            .await?;
+            Ok::<(), JSONRPCErrorError>(())
+        }
+        .await;
+        if let Err(error) = switched {
+            if let Ok(partial) = self.thread_manager.get_thread(id).await {
+                if !partial
+                    .shutdown_if_idle()
+                    .await
+                    .map_err(|_| internal_error("cannot stop failed identity runtime"))?
+                {
+                    return Err(internal_error(
+                        "replacement runtime became active before rollback; identity requires re-verification",
+                    ));
+                }
+                self.thread_manager.remove_thread(&id).await;
+            }
+            self.save_identity_binding(id, previous.as_ref()).await?;
+            self.reload_paginated_thread(&request_id, id, old, client_name, client_version)
+                .await
+                .map_err(|rollback| {
+                    internal_error(format!(
+                        "identity change failed: {}; original runtime restore failed: {}",
+                        error.message, rollback.message
+                    ))
+                })?;
+            return Err(error);
+        }
+        self.identity_bindings.lock().await.insert(id, binding);
+        self.thread_identity_read(ThreadIdentityReadParams {
+            thread_id: id.to_string(),
+        })
+        .await
+        }.await;
+        if !was_subscribed {
+            self.thread_state_manager
+                .unsubscribe_connection_from_thread(id, request_id.connection_id)
+                .await;
+        }
+        result
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::validate_identity_id;
+
+    #[test]
+    fn identity_references_cannot_escape_the_profile_directory() {
+        for value in [
+            "", "../auth", "..\\auth", "C:\\auth", "a/b", "a:b", ".", "官方",
+        ] {
+            assert!(validate_identity_id(value).is_err());
+        }
+        assert!(validate_identity_id("official_1234-abcd").is_ok());
+    }
+}
