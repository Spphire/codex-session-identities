+pub(super) fn enrollment_client_version(installed: Option<&str>) -> String {
+    let valid = installed.filter(|version| {
+        let mut segments = version.splitn(2, '-');
+        let core = segments.next().unwrap_or_default();
+        let numbers: Vec<_> = core.split('.').collect();
+        core != "0.0.0"
+            && numbers.len() == 3
+            && numbers
+                .iter()
+                .all(|part| !part.is_empty() && part.bytes().all(|byte| byte.is_ascii_digit()))
+            && segments.next().is_none_or(|suffix| {
+                !suffix.is_empty()
+                    && suffix
+                        .bytes()
+                        .all(|byte| byte.is_ascii_alphanumeric() || byte == b'.' || byte == b'-')
+            })
+    });
+    valid.unwrap_or(env!("CARGO_PKG_VERSION")).to_owned()
+}
+
+#[cfg(test)]
+#[test]
+fn enrollment_uses_installed_client_version_with_compiled_fallback() {
+    assert_eq!(
+        enrollment_client_version(Some("0.162.0-alpha.17.2")),
+        "0.162.0-alpha.17.2"
+    );
+    for invalid in [
+        None,
+        Some("0.0.0"),
+        Some("not-a-version"),
+        Some("1.2.3\n"),
+        Some("1.2.3-"),
+    ] {
+        assert_eq!(
+            enrollment_client_version(invalid),
+            env!("CARGO_PKG_VERSION")
+        );
+    }
+}
