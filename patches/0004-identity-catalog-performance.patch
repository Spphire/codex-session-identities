diff --git a/codex-rs/core/src/thread_manager_tests.rs b/codex-rs/core/src/thread_manager_tests.rs
index 5e1e71f..6da498d 100644
--- a/codex-rs/core/src/thread_manager_tests.rs
+++ b/codex-rs/core/src/thread_manager_tests.rs
@@ -111,6 +111,46 @@ async fn identity_auth_overrides_do_not_share_the_process_account_or_catalog() {
 
 struct ParentInstructionsProvider(codex_extension_api::Instructions);
 
+#[tokio::test]
+async fn identity_catalog_prewarm_survives_reload_without_evicting_sibling_cache() {
+    let server = MockServer::start().await;
+    let other_server = MockServer::start().await;
+    let _ = mount_models_once(&server, ModelsResponse { models: vec![] }).await;
+    let _ = mount_models_once(&other_server, ModelsResponse { models: vec![] }).await;
+    let _ = mount_models_once(&other_server, ModelsResponse { models: vec![] }).await;
+    let home = tempdir().expect("home");
+    let mut config = test_config().await;
+    config.codex_home = home.path().abs();
+    config.model_catalog = None;
+    config.model_provider.base_url = Some(server.uri());
+    config.identity_model_cache_home = Some(home.path().join("profiles/a/model-catalog"));
+    let auth = AuthManager::from_auth_for_testing(
+        CodexAuth::create_dummy_chatgpt_auth_for_testing(),
+    );
+    let refresh = |config: Config, auth: Arc<AuthManager>| async move {
+        build_models_manager(&config, auth)
+            .list_models(
+                RefreshStrategy::OnlineIfUncached,
+                crate::test_support::default_http_client_factory(),
+            )
+            .await;
+    };
+    refresh(config.clone(), Arc::clone(&auth)).await;
+    let mut sibling = config.clone();
+    sibling.identity_model_cache_home = Some(home.path().join("profiles/b/model-catalog"));
+    sibling.model_provider.base_url = Some(other_server.uri());
+    refresh(sibling, Arc::clone(&auth)).await;
+    // A new manager, as used by runtime replacement, must reuse only A's catalog.
+    refresh(config.clone(), Arc::clone(&auth)).await;
+    assert_eq!(server.received_requests().await.expect("requests").len(), 1);
+    assert_eq!(other_server.received_requests().await.expect("requests").len(), 1);
+    assert!(!config.codex_home.join("models_cache.json").exists());
+    // Reusing the profile directory cannot reuse a catalog for a changed provider.
+    config.model_provider.base_url = Some(other_server.uri());
+    refresh(config, auth).await;
+    assert_eq!(other_server.received_requests().await.expect("requests").len(), 2);
+}
