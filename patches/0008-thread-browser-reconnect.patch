+impl ThreadRequestProcessor {
+    pub(crate) async fn thread_browser(
+        &self,
+        params: ThreadIdentityReadParams,
+        reload: bool,
+    ) -> Result<codex_app_server_protocol::ThreadBrowserResponse, JSONRPCErrorError> {
+        let id = ThreadId::from_string(&params.thread_id)
+            .map_err(|_| invalid_params("invalid thread ID"))?;
+        let _permit = self.acquire_thread_list_state_permit().await?;
+        let mut status = "unloaded";
+        if let Ok(thread) = self.thread_manager.get_thread(id).await {
+            let config = thread.config().await;
+            // Reuse the resolved Desktop configuration; never synthesize trust or grants.
+            let configured = config.mcp_servers.get().iter().any(|(name, server)| {
+                server.enabled && (name == "node_repl" || name == "cua_repl") &&
+                match &server.transport {
+                    codex_config::McpServerTransportConfig::Stdio { env: Some(env), .. } =>
+                        env.get("BROWSER_USE_AVAILABLE_BACKENDS").is_some_and(|value|
+                            value.split(',').any(|backend| backend.trim() == "iab")),
+                    _ => false,
+                }
+            });
+            status = if !configured { "unconfigured" }
+                else if matches!(thread.agent_status().await, AgentStatus::Running)
+                    || matches!(self.thread_watch_manager.loaded_status_for_thread(&id.to_string()).await, ThreadStatus::Active { .. })
+                { "busy" } else { "ready" };
+            if reload && status == "ready" {
+                thread.submit(codex_protocol::protocol::Op::RefreshMcpServers).await
+                    .map_err(|_| internal_error("browser reconnect submission failed"))?;
+                status = "queued";
+            }
+        }
+        Ok(codex_app_server_protocol::ThreadBrowserResponse {
+            thread_id: id.to_string(), revision: 1, status: status.to_string(),
+        })
+    }
+}
