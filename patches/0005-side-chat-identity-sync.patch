+                        cwd_filters: None,
+                        section: None,
+                        project_id: None,
+                        archived,
+                        search_term: None,
+                        relation_filter: None,
+                        use_state_db_only: true,
+                    })
+                    .await
+                    .map_err(|error| internal_error(format!("cannot inspect side chats: {error}")))?;
+                records.extend(page.items);
+                let Some(next) = page.next_cursor else { break };
+                if cursor.as_ref() == Some(&next) { break }
+                cursor = Some(next);
+            }
+        }
+        let mut parents = HashMap::new();
+        for (&child, binding) in self.identity_bindings.lock().await.iter() {
+            if let Some(parent) = binding.parent_thread_id {
+                parents.entry(child).or_insert(parent);
+            }
+        }
+        for record in records {
+            if let Some(parent) = record.forked_from_id.or(record.parent_thread_id) {
+                parents.entry(record.thread_id).or_insert(parent);
+            }
+        }
+        let mut descendants = Vec::new();
+        let mut frontier = vec![root];
+        while let Some(parent) = frontier.pop() {
+            for (&child, &candidate_parent) in &parents {
+                if candidate_parent == parent && !descendants.contains(&child) {
+                    descendants.push(child);
+                    frontier.push(child);
+                }
+            }
+        }
+        Ok(descendants)
+    }
