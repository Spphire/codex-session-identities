 impl ThreadRequestProcessor {
+    /// Explicit, confirmed panel operation. Scope is the selected root's live
+    /// agent subtree, never ordinary independent forks or other roots.
+    pub(crate) async fn thread_identity_force_set(
+        &self,
+        request_id: ConnectionRequestId,
+        params: ThreadIdentitySetParams,
+        client_name: Option<String>,
+        client_version: Option<String>,
+    ) -> Result<ThreadIdentityResponse, JSONRPCErrorError> {
+        validate_identity_id(&params.identity_id)?;
+        let id = ThreadId::from_string(&params.thread_id).map_err(|_| invalid_params("invalid thread ID"))?;
+        let current = self.thread_identity_read(ThreadIdentityReadParams { thread_id: params.thread_id.clone() }).await?;
+        if current.verified && current.identity_id.as_ref() == Some(&params.identity_id) { return Ok(current); }
+        if current.revision != params.expected_revision { return Err(invalid_request("identity revision changed; refresh before forcing")); }
+        let Ok(thread) = self.thread_manager.get_thread(id).await else {
+            return self.thread_identity_set(request_id, params, client_name, client_version).await;
+        };
+        let snapshot = thread.config_snapshot().await;
+        if snapshot.ephemeral || snapshot.session_source.is_non_root_agent() {
+            return Err(invalid_request("forced identity switch requires a persisted root thread"));
+        }
+        // Reject an invalid target before interrupting any work.
+        let config = thread.config().await;
+        let _prepared = self.prepare_identity_runtime(config.as_ref(), &params.identity_id).await?;
+        let deadline = std::time::Instant::now() + Duration::from_secs(90);
+        for _ in 0..32 {
+            if std::time::Instant::now() >= deadline { break; }
+            let binding = self.load_identity_binding(id).await?;
+            if binding.as_ref().map_or(0, |b| b.revision) != params.expected_revision {
+                return Err(invalid_request("identity changed while forcing; cleanup stopped"));
+            }
+            if matches!(thread.agent_status().await, AgentStatus::Running) {
+                thread.submit(codex_protocol::protocol::Op::Interrupt).await.map_err(|_| internal_error("could not interrupt selected chat"))?;
+            }
+            while matches!(thread.agent_status().await, AgentStatus::Running) {
+                if std::time::Instant::now() >= deadline { return Err(internal_error("selected reply did not stop; identity not verified")); }
+                tokio::time::sleep(Duration::from_millis(50)).await;
+            }
+            for terminal in thread.list_background_terminals().await {
+                let process = terminal.process_id.parse::<i32>().map_err(|_| internal_error("invalid owned terminal reference"))?;
+                thread.terminate_background_terminal(process).await;
+            }
+            let children = self.thread_manager.list_agent_subtree_thread_ids(id).await.map_err(|_| internal_error("cannot inspect owned subagents"))?;
+            for child in children {
+                if child == id { continue; }
+                if std::time::Instant::now() >= deadline { return Err(internal_error("owned subagent cleanup deadline exceeded; identity not verified")); }
+                if let Ok(child_thread) = self.thread_manager.get_thread(child).await {
+                    retain_identity_child_result(&thread, child, child_thread.agent_status().await).await?;
+                    let remaining = deadline.saturating_duration_since(std::time::Instant::now()).min(Duration::from_secs(10));
+                    if !matches!(tokio::time::timeout(remaining, child_thread.shutdown_and_wait()).await, Ok(Ok(()))) {
+                        return Err(internal_error("owned subagent did not stop; identity not verified"));
+                    }
+                    if self.thread_manager.remove_thread_if_matches(&child, &child_thread).await.is_some() { self.finalize_thread_teardown(child).await; }
+                }
+            }
+            let result = self.thread_identity_set(request_id.clone(), params.clone(), client_name.clone(), client_version.clone()).await?;
+            if result.status != "busy" { return Ok(result); }
+            tokio::time::sleep(Duration::from_millis(100)).await;
+        }
+        Err(internal_error("forced cleanup did not converge; identity not verified; inspect remaining work"))
+    }
