+async fn retain_identity_child_result(thread: &codex_core::CodexThread, child: ThreadId, status: AgentStatus) -> Result<(), JSONRPCErrorError> {
+    let message = match status {
+        AgentStatus::Completed(Some(message)) => Some(message),
+        AgentStatus::Errored(error) => Some(format!("Subagent ended with error: {error}")),
+        _ => None,
+    };
+    if let Some(message) = message {
+        thread.inject_response_items(vec![codex_protocol::models::ResponseItem::Message {
+            id: None, encrypted_content: None, status: Some("completed".to_string()), role: "assistant".to_string(),
+            content: vec![codex_protocol::models::ContentItem::OutputText {
+                annotations: None, logprobs: None,
+                text: format!("Retained result from completed subagent {child} before identity switch:\n{message}"),
+            }], phase: None, internal_chat_message_metadata_passthrough: None,
+        }]).await.map_err(|_| internal_error("cannot preserve completed subagent result; identity unchanged"))?;
+    }
+    Ok(())
